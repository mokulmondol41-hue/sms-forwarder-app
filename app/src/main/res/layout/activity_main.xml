<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#F4F5FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SMS পেমেন্ট ফরওয়ার্ডার"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1B1B2F"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="bKash/Nagad পেমেন্ট SMS এলে অটোমেটিক আপনার সার্ভারে পাঠাবে"
        android:textSize="13sp"
        android:textColor="#7A7E92"
        android:gravity="center"
        android:layout_marginBottom="36dp" />

    <Button
        android:id="@+id/btnToggle"
        android:layout_width="200dp"
        android:layout_height="64dp"
        android:text="START"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#E2136E" />

    <TextView
        android:id="@+id/tvState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="অবস্থা: বন্ধ আছে"
        android:textSize="14sp"
        android:textColor="#1B1B2F"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tvLast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textColor="#7A7E92"
        android:gravity="center"
        android:layout_marginTop="14dp" />

</LinearLayout>
